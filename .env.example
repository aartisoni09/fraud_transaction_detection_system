# ── FraudGuard Configuration ──────────────────────────────────
# Copy this file to .env and customize for your environment.

# API Configuration
API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000

# Security (leave empty to disable authentication)
API_KEY=
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# Database
DATABASE_URL=fraudguard.db

# Model & Data Paths
MODEL_BUNDLE_PATH=model_bundle.pkl
METRICS_PATH=metrics.json
DATASET_PATH=fraud_dataset_1500.csv

# Risk Thresholds
CRITICAL_THRESHOLD=0.80
MEDIUM_THRESHOLD=0.30

# Logging
LOG_LEVEL=INFO
